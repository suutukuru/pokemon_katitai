{
  "name": "champions-analyzer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "reg:new": "tsx packages/cli/src/bin.ts reg:new",
    "reg:diff": "tsx packages/cli/src/bin.ts reg:diff",
    "reg:validate": "tsx packages/cli/src/bin.ts reg:validate",
    "data:import-official": "tsx packages/cli/src/bin.ts data:import-official",
    "data:import-smogon": "tsx packages/cli/src/bin.ts data:import-smogon",
    "data:import-pokedb": "tsx packages/cli/src/bin.ts data:import-pokedb",
    "data:build-i18n": "tsx packages/cli/src/bin.ts data:build-i18n",
    "team:check": "tsx packages/cli/src/bin.ts team:check",
    "calc": "tsx packages/cli/src/bin.ts calc",
    "meta": "tsx packages/cli/src/bin.ts meta",
    "sim": "tsx packages/cli/src/bin.ts sim",
    "sim:meta": "tsx packages/cli/src/bin.ts sim:meta",
    "report:meta": "tsx packages/cli/src/bin.ts report:meta",
    "team:fill": "tsx packages/cli/src/bin.ts team:fill",
    "report:book": "tsx packages/cli/src/bin.ts report:book",
    "report:replay": "tsx packages/cli/src/bin.ts report:replay",
    "report:battle": "tsx packages/cli/src/bin.ts report:battle",
    "web:dev": "pnpm --filter @ca/web dev",
    "web:build": "pnpm --filter @ca/web build",
    "web:artifact": "pnpm --filter @ca/web build && node apps/web/scripts/artifact-page.mjs",
    "e2e": "pnpm --filter @ca/web e2e",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.3",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
